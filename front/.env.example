# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
# Supabase: use Connect > Session pooler (port 5432) on both computers.
# URL-encode the database password. Keep this URL server-side.
# POSTGRES_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Optional direct/session URL for migrations if POSTGRES_URL uses transaction mode.
# POSTGRES_MIGRATION_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
