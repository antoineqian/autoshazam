# Copy to backend/.env and fill in. Gitignored; never commit real credentials.
# Only the Soulseek account is required, and only to enable track downloads.
SOULSEEK_ACCOUNT=your_soulseek_login
SOULSEEK_PASSWORD=your_soulseek_password

# Port peers connect back to. Forward it on your router, or downloads queue
# forever behind NAT.
SOULSEEK_LISTEN_PORT=2234

# Where finished files land, one folder per analysed source.
SOULSEEK_DOWNLOAD_DIR=./downloads
